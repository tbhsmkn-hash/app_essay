{
  "model_name": "MultimodalEssayModel",
  "text_backbone": "distilbert-base-uncased",
  "image_backbone": "resnet18",
  "fusion_dim": 256,
  "dropout": 0.3,
  "max_len": 512,
  "img_size": 224,
  "num_classes": 6,
  "metrics": {
    "target_metric": "cohen_kappa_score",
    "best_score": 0.845
  },
  "label_mapping": {
    "0": "Score 1",
    "1": "Score 2",
    "2": "Score 3",
    "3": "Score 4",
    "4": "Score 5",
    "5": "Score 6"
  }
}
